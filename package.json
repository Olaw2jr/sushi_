{
  "name": "sushi",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:storybook": "ENVFILE=.env.storybook npm run android",
    "ios": "react-native run-ios --simulator=\"iPhone 14\"",
    "start": "react-native start",
    "test": "TZ=UTC jest ./*.unit.test.* --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "generate": "plop",
    "android:debug": "npm run android:bundle-js && npm run android:build-debug-apk",
    "android:release": "cd android && ./gradlew bundleRelease && cd ..",
    "android:bundle-js": "react-native bundle --dev false --platform android --entry-file index.js --bundle-output ./android/app/src/main/assets/index.android.bundle --assets-dest ./android/app/src/main/res",
    "android:build-debug-apk": "cd android && ./gradlew assembleDebug && cd .."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@reduxjs/toolkit": "^2.12.0",
    "@storybook/react-native": "^5.3.25",
    "date-fns": "^4.4.0",
    "lucide-react-native": "^1.28.0",
    "numbro": "^2.5.0",
    "ramda": "^0.32.0",
    "react": "^19.2.8",
    "react-native": "^0.86.2",
    "react-native-blob-util": "^0.24.10",
    "react-native-calendars": "^1.1314.0",
    "react-native-chart-kit": "^7.0.2",
    "react-native-config": "^1.6.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "react-native-splash-screen": "^3.2.0",
    "react-native-svg": "^15.15.5",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native/babel-preset": "^0.86.2",
    "@react-native/eslint-config": "^0.86.2",
    "@react-native/eslint-plugin": "^0.86.2",
    "@react-native/jest-preset": "^0.86.2",
    "@react-native/metro-config": "^0.86.2",
    "@react-native/typescript-config": "^0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/ramda": "^0.32.0",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-module-resolver": "^4.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-ft-flow": "^2.0.3",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "plop": "^2.7.4",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
